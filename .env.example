# Runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_POOL_MAX=5
POSTGRES_DB=wayfair
POSTGRES_USER=wayfair
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_DOMAIN=ops.example.com
APP_ORIGIN=https://ops.example.com
CRON_SECRET=replace-with-a-long-random-value
WAYFAIR_DEPLOYMENT_ENV=production
APP_ACCESS_USER=operator
APP_ACCESS_PASSWORD=replace-with-a-long-random-password
ENABLE_SCHEDULER=false

# S3-compatible report storage
S3_BUCKET=wayfair-ops
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.example.com
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_DEFAULT_CREDENTIAL_CHAIN=false
MINIO_ROOT_USER=wayfair-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Microsoft Graph: use either delegated refresh token or app mailbox access
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
OUTLOOK_MAILBOX_USER=

# Wayfair read APIs
WAYFAIR_OPS_CLIENT_ID=
WAYFAIR_OPS_CLIENT_SECRET=
WAYFAIR_AD_CLIENT_ID=
WAYFAIR_AD_CLIENT_SECRET=
WAYFAIR_CATALOG_CLIENT_ID=
WAYFAIR_CATALOG_CLIENT_SECRET=
WAYFAIR_CATALOG_SUPPLIER_ID=

# Explicit production identity and write gates
WAYFAIR_EXPECTED_SUPPLIER_IDS=
ALLOW_WAYFAIR_AD_LIVE_CHANGES=false
ALLOW_WAYFAIR_LIVE_PUSH=false

# Optional compatibility token for POST /api/email/daily
OUTLOOK_INGEST_TOKEN=
